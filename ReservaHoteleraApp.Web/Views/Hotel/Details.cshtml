@* Vista: detalles de un hotel (solo lectura). *@
@model ReservaHoteleraApp.DAL.Models.Objects.Hotel.HotelModel

@{
    ViewData["Title"] = "Detalles del Hotel";
}

<h1>Detalles del Hotel</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Id)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Nombre)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Direccion)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Direccion)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Telefono)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Telefono)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Ciudad)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Ciudad)</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>
