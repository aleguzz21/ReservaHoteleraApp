@model IEnumerable<ReservaHoteleraApp.DAL.Models.Objects.Hotel.HotelModel>
@using ReservaHoteleraApp.DAL.Models.Objects.Habitacion
@using ReservaHoteleraApp.DAL.Models.Objects.Hotel

@{
    ViewData["Title"] = "Inicio";
    var entrada = ViewData["FechaEntrada"] as DateTime?;
    var salida = ViewData["FechaSalida"] as DateTime?;
    var hotelSeleccionado = ViewData["HotelId"] as int?;
    var buscando = ViewData["Buscando"] is bool valor && valor;
    var habitaciones = ViewData["Habitaciones"] as List<HabitacionModel> ?? new List<HabitacionModel>();
    var haySesion = User.Identity?.IsAuthenticated == true;

    // Fecha de hoy en formato yyyy-MM-dd (el que entiende <input type="date">).
    var hoy = DateTime.Today.ToString("yyyy-MM-dd");
}

<section class="booking-hero">
    <div class="booking-hero-container">
        <div class="booking-hero-text">
            <h1 class="booking-hero-title">Encuentra tu próxima estancia</h1>
            <p class="booking-hero-subtitle">Busca ofertas en los hoteles mejores valorados</p>
        </div>

        <form class="booking-search" method="get" asp-controller="Hotel" asp-action="Index">
            <div class="booking-search-field booking-search-destination">
                <span class="booking-search-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 5v14M3 12h18v7M7 12V8h6v4" />
                        <path d="M17 12V9h4v3" />
                    </svg>
                </span>
                <div class="booking-search-body">
                    <label for="destino">Indica el destino</label>
                    <input id="destino" name="destino" type="text" placeholder="¿Adónde vas?" autocomplete="off" />
                </div>
            </div>
            @*
            <div class="booking-search-field booking-search-dates">
                <span class="booking-search-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="17" rx="2" />
                        <path d="M3 9h18M8 2v4M16 2v4" />
                    </svg>
                </span>
                
                <div class="booking-search-body">
                    <label>Seleccionar fechas</label>
                    <div class="booking-dates-row">
                        <input id="fechaEntrada" type="date" name="fechaEntrada" aria-label="Fecha de entrada"
                               min="@hoy" value="@(entrada?.ToString("yyyy-MM-dd"))" />
                        <span class="booking-dates-sep">—</span>
                        <input id="fechaSalida" type="date" name="fechaSalida" aria-label="Fecha de salida"
                               min="@hoy" value="@(salida?.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>
            </div>

            <div class="booking-search-field booking-search-occupancy">
                <span class="booking-search-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
                    </svg>
                </span>
                <div class="booking-search-body">
                    <label>Selecciona la ocupación</label>
                    <div class="booking-occupancy-row">
                        <select name="adultos" aria-label="Adultos">
                            <option value="1">1 adulto</option>
                            <option value="2" selected>2 adultos</option>
                            <option value="3">3 adultos</option>
                            <option value="4">4 adultos</option>
                        </select>
                        <select name="ninos" aria-label="Niños">
                            <option value="0" selected>0 niños</option>
                            <option value="1">1 niño</option>
                            <option value="2">2 niños</option>
                            <option value="3">3 niños</option>
                        </select>
                        <select name="habitaciones" aria-label="Habitaciones">
                            <option value="1" selected>1 habitación</option>
                            <option value="2">2 habitaciones</option>
                            <option value="3">3 habitaciones</option>
                            <option value="4">4 habitaciones</option>
                        </select>
                    </div>
                </div>
            </div>*@

            <button type="submit" class="booking-search-btn">Buscar</button>
        </form>

        @*<label class="booking-work-check">
            <input type="checkbox" /> Viajo por trabajo
        </label>*@
    </div>
</section>

<section class="booking-availability" id="disponibles">
    <h2 class="booking-section-title">Reserva tu habitación</h2>
    <p class="booking-availability-subtitle">Elige el hotel y las fechas para ver las habitaciones disponibles.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form class="booking-availability-form" method="get" asp-controller="Home" asp-action="Index">
        <div class="booking-availability-field">
            <label for="homeHotelId">Hotel</label>
            <select id="homeHotelId" name="hotelId">
                <option value="">Todos los hoteles</option>
                @foreach (var hotel in Model)
                {
                    if (hotelSeleccionado == hotel.Id)
                    {
                        <option value="@hotel.Id" selected>@hotel.Nombre</option>
                    }
                    else
                    {
                        <option value="@hotel.Id">@hotel.Nombre</option>
                    }
                }
            </select>
        </div>
        <div class="booking-availability-field">
            <label for="homeFechaEntrada">Entrada</label>
            <input id="homeFechaEntrada" name="fechaEntrada" type="date" min="@hoy"
                   value="@(entrada?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="booking-availability-field">
            <label for="homeFechaSalida">Salida</label>
            <input id="homeFechaSalida" name="fechaSalida" type="date" min="@hoy"
                   value="@(salida?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit" class="booking-search-btn">Ver habitaciones</button>
    </form>

    @if (buscando)
    {
        <h3 class="booking-availability-results-title">
            Habitaciones libres del @(entrada?.ToString("dd/MM/yyyy")) al @(salida?.ToString("dd/MM/yyyy"))
        </h3>

        if (!habitaciones.Any())
        {
            <p class="booking-empty">
                No hay habitaciones disponibles con esos criterios.
                <a class="booking-link-all" asp-action="Index">Quitar filtros</a>
            </p>
        }
        else
        {
            <div class="booking-availability-grid">
                @foreach (var habitacion in habitaciones)
                {
                    <article class="booking-room-card">
                        <div class="booking-room-head">
                            <h4>@habitacion.HotelNombre</h4>
                            <span class="booking-room-price">@habitacion.PrecioNoche.ToString("C") / noche</span>
                        </div>
                        <p class="booking-room-meta">
                            Habitación @habitacion.Numero
                            @if (habitacion.PisoNumero.HasValue)
                            {
                                <text> · Piso @habitacion.PisoNumero</text>
                            }
                            <br />
                            @habitacion.TipoHabitacionNombre
                        </p>
                        <div class="booking-room-actions">
                            @if (haySesion)
                            {
                                <a class="booking-room-cta"
                                   asp-controller="Reserva" asp-action="Create"
                                   asp-route-habitacionId="@habitacion.Id"
                                   asp-route-fechaEntrada="@(entrada?.ToString("yyyy-MM-dd"))"
                                   asp-route-fechaSalida="@(salida?.ToString("yyyy-MM-dd"))">Reservar</a>
                            }
                            else
                            {
                                <a class="booking-room-login" asp-controller="Account" asp-action="Login">
                                    Inicia sesión para reservar
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
            <p class="booking-availability-more">
                <a class="booking-link-all" asp-controller="Habitacion" asp-action="Index"
                   asp-route-fechaEntrada="@(entrada?.ToString("yyyy-MM-dd"))"
                   asp-route-fechaSalida="@(salida?.ToString("yyyy-MM-dd"))">Ver el listado completo</a>
            </p>
        }
    }
</section>

