@* Vista: "Mis reservas". El administrador ve las de todos; el cliente solo las suyas. *@
@using ReservaHoteleraApp.DAL.Models.Objects.Reserva
@model IEnumerable<ReservaDetalleModel>

@{
    ViewData["Title"] = "Mis reservas";
    var esAdministrador = User.IsInRole("Administrador");
}

<h1>Mis reservas</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay reservas.
        <a asp-controller="Habitacion" asp-action="Index">Ver habitaciones disponibles</a>
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                @if (esAdministrador)
                {
                    <th>Cliente</th>
                }
                <th>Alojamiento</th>
                <th>Habitación</th>
                <th>Entrada</th>
                <th>Salida</th>
                <th>Noches</th>
                <th>Personas</th>
                <th>Total</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @if (esAdministrador)
                {
                    <td>@item.ClienteNombre</td>
                }
                <td>
                    @item.HotelNombre
                    @if (!string.IsNullOrWhiteSpace(item.Ciudad))
                    {
                        <br /><small class="text-muted">@item.Ciudad</small>
                    }
                </td>
                <td>
                    @item.NumeroHabitacion
                    <br /><small class="text-muted">
                        Piso @item.PisoNumero · @item.TipoHabitacionNombre
                    </small>
                </td>
                <td>@item.FechaEntrada.ToString("dd/MM/yyyy")</td>
                <td>@(item.FechaSalida?.ToString("dd/MM/yyyy"))</td>
                <td>@item.Noches</td>
                <td>@item.CantidadPersonas</td>
                <td>@item.TotalReserva.ToString("C")</td>
                <td>
                    @if (item.Estado == "Cancelada")
                    {
                        <span class="badge bg-secondary">Cancelada</span>
                    }
                    else
                    {
                        <span class="badge bg-success">@item.Estado</span>
                    }
                </td>
                <td class="text-end">
                    @if (item.Estado != "Cancelada")
                    {
                        <form asp-action="Cancelar" method="post" class="d-inline"
                              onsubmit="return confirm('¿Cancelar esta reserva?');">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<a asp-controller="Habitacion" asp-action="Index" class="btn btn-secondary">Volver a habitaciones</a>
