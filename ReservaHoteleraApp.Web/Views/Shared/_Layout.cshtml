<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - A&V Solutions</title>
    <link rel="icon" type="image/png" sizes="64x64" href="~/Images/favicon.png" />
    <link rel="apple-touch-icon" href="~/Images/favicon-512.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReservaHoteleraApp.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="booking-header">
        <div class="container">
            <nav class="booking-nav-top">
                <a class="booking-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/Images/logo.png" alt="A&V Solutions" asp-append-version="true" />
                </a>
                <ul class="booking-nav-actions">
                    <li class="booking-currency">
                        <span class="booking-currency-code">DOP</span>
                        <span class="booking-flag" aria-hidden="true"></span>
                    </li>
                    <li>
                        <a class="booking-link-light" asp-area="" asp-controller="Hotel" asp-action="Create">Registra tu alojamiento</a>
                    </li>
                    <li>
                        <a class="btn booking-btn-light" asp-area="" asp-controller="Hotel" asp-action="Index">Ver hoteles</a>
                    </li>
                </ul>
                <button class="booking-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#bookingMenu" aria-controls="bookingMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span></span><span></span><span></span>
                </button>
            </nav>
            <div class="booking-menu collapse d-lg-block" id="bookingMenu">
                <ul class="booking-nav-tabs">
                    <li class="booking-tab">
                        <a asp-area="" asp-controller="Home" asp-action="Index" title="Página principal">Inicio</a>
                    </li>
                    <li class="booking-tab">
                        <a asp-area="" asp-controller="Hotel" asp-action="Index" title="Nivel 1 · Hotel">Hoteles</a>
                    </li>
                    <li class="booking-tab">
                        <a asp-area="" asp-controller="Bloque" asp-action="Index" title="Nivel 2 · Bloque (pertenece a un hotel)">Bloques</a>
                    </li>
                    <li class="booking-tab">
                        <a asp-area="" asp-controller="Piso" asp-action="Index" title="Nivel 3 · Piso (pertenece a un bloque)">Pisos</a>
                    </li>
                    <li class="booking-tab">
                        <a asp-area="" asp-controller="TipoHabitacion" asp-action="Index" title="Catálogo · Tipo de habitación (requerido por la habitación)">Tipos de Habitación</a>
                    </li>
                    <li class="booking-tab">
                        <a asp-area="" asp-controller="Habitacion" asp-action="Index" title="Nivel 4 · Habitación (piso + tipo de habitación)">Habitaciones</a>
                    </li>
                </ul>
            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="booking-footer">
        <div class="container">
            &copy; 2026 - A&V Solutions - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
