@* Vista: detalles de un tipo de habitación (solo lectura). *@
@model ReservaHoteleraApp.DAL.Models.Objects.TipoHabitacion.TipoHabitacionModel

@{
    ViewData["Title"] = "Detalles del Tipo de Habitación";
}

<h1>Detalles del Tipo de Habitación</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Id)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Id)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Nombre)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Nombre)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Descripcion)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Descripcion)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Capacidad)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Capacidad)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Precio)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(m => m.Precio)</dd>
</dl>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Volver a la lista</a>
</div>
