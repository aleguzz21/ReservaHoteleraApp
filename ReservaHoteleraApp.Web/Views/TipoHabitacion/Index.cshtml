@* Vista: lista de tipos de habitación (catálogo de mantenimiento). *@
@model IEnumerable<ReservaHoteleraApp.DAL.Models.Objects.TipoHabitacion.TipoHabitacionModel>

@{
    ViewData["Title"] = "Tipos de Habitación";
}

<h1>Mantenimiento de Tipos de Habitación</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Tipo de Habitación</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
            <th>@Html.DisplayNameFor(m => m.Capacidad)</th>
            <th>@Html.DisplayNameFor(m => m.Precio)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.Nombre)</td>
            <td>@Html.DisplayFor(m => item.Descripcion)</td>
            <td>@Html.DisplayFor(m => item.Capacidad)</td>
            <td>@Html.DisplayFor(m => item.Precio)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
