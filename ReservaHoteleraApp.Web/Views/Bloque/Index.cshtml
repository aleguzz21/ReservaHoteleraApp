@* Vista: lista de bloques.
   Recibe una colección de BloqueModel y la dibuja en una tabla.
   Cada enlace Editar/Detalles/Eliminar lleva el id en la URL con asp-route-id. *@
@model IEnumerable<ReservaHoteleraApp.DAL.Models.Objects.Bloque.BloqueModel>

@{
    ViewData["Title"] = "Bloques";
}

<h1>Gestión de Bloques</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Bloque</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Nombre)</th>
            <th>@Html.DisplayNameFor(m => m.HotelNombre)</th>
            <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.Nombre)</td>
            <td>@Html.DisplayFor(m => item.HotelNombre)</td>
            <td>@Html.DisplayFor(m => item.Descripcion)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
