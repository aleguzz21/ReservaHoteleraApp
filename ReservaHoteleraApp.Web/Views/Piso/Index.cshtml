@* Vista: lista de pisos.
   Muestra el número de piso y el nombre del bloque al que pertenece (BloqueNombre). *@
@model IEnumerable<ReservaHoteleraApp.DAL.Models.Objects.Piso.PisoModel>

@{
    ViewData["Title"] = "Pisos";
}

<h1>Gestión de Pisos</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Piso</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Numero)</th>
            <th>@Html.DisplayNameFor(m => m.BloqueNombre)</th>
            <th>@Html.DisplayNameFor(m => m.Descripcion)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.Numero)</td>
            <td>@Html.DisplayFor(m => item.BloqueNombre)</td>
            <td>@Html.DisplayFor(m => item.Descripcion)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
