@* Vista: habitaciones disponibles para un rango de fechas.
   El cliente elige fechas, ve solo las libres y pulsa "Reservar".
   El administrador puede cambiar a "Ver todas" para gestionar el inventario. *@
@model IEnumerable<ReservaHoteleraApp.DAL.Models.Objects.Habitacion.HabitacionModel>

@{
    ViewData["Title"] = "Habitaciones disponibles";
    var entrada = (string)ViewBag.FechaEntrada;
    var salida = (string)ViewBag.FechaSalida;
    var entradaFecha = (DateTime)ViewBag.EntradaFecha;
    var salidaFecha = (DateTime)ViewBag.SalidaFecha;
    var verTodas = ViewBag.VerTodas is bool valor && valor;
    var haySesion = User.Identity?.IsAuthenticated == true;
}

<h1>Habitaciones disponibles</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row mb-4">
    <div class="col-md-7">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-sm-4">
                <label for="fechaEntrada" class="form-label">Entrada</label>
                <input id="fechaEntrada" name="fechaEntrada" type="date" class="form-control"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@entrada" />
            </div>
            <div class="col-sm-4">
                <label for="fechaSalida" class="form-label">Salida</label>
                <input id="fechaSalida" name="fechaSalida" type="date" class="form-control"
                       min="@entrada" value="@salida" />
            </div>
            <div class="col-sm-4">
                <button type="submit" class="btn btn-primary w-100">Buscar disponibles</button>
            </div>
        </form>
    </div>
</div>

<p class="text-muted">
    @if (verTodas)
    {
        <text>Mostrando todas las habitaciones (inventario).</text>
        <a asp-action="Index" asp-route-fechaEntrada="@entrada" asp-route-fechaSalida="@salida">Volver a disponibles</a>
    }
    else
    {
        <text>Libres del @entradaFecha.ToString("dd/MM/yyyy") al @salidaFecha.ToString("dd/MM/yyyy").</text>
        if (User.IsInRole("Administrador"))
        {
            <text> · </text>
            <a asp-action="Index" asp-route-verTodas="true">Ver todas</a>
        }
    }
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay habitaciones disponibles en esas fechas.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Hotel</th>
                <th>Habitación</th>
                <th>Piso</th>
                <th>Tipo de Habitación</th>
                <th>@Html.DisplayNameFor(m => m.PrecioNoche)</th>
                @if (verTodas)
                {
                    <th>@Html.DisplayNameFor(m => m.Estado)</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.HotelNombre
                    @if (!string.IsNullOrWhiteSpace(item.Ciudad))
                    {
                        <br /><small class="text-muted">@item.Ciudad</small>
                    }
                </td>
                <td>@Html.DisplayFor(m => item.Numero)</td>
                <td>@Html.DisplayFor(m => item.PisoNumero)</td>
                <td>@Html.DisplayFor(m => item.TipoHabitacionNombre)</td>
                <td>@Html.DisplayFor(m => item.PrecioNoche)</td>
                @if (verTodas)
                {
                    <td>@Html.DisplayFor(m => item.Estado)</td>
                }
                <td class="text-end">
                    @if (haySesion)
                    {
                        <a class="btn btn-sm btn-primary"
                           asp-controller="Reserva" asp-action="Create"
                           asp-route-habitacionId="@item.Id"
                           asp-route-fechaEntrada="@entrada"
                           asp-route-fechaSalida="@salida">Reservar</a>
                    }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalles</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (haySesion)
{
    <a asp-controller="Reserva" asp-action="Index" class="btn btn-secondary">Mis reservas</a>
}
